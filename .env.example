# Supabase — from Project Settings → API.
#
# Read at request time, not baked into the build, so the same Docker image runs
# in any environment and rotating a key needs no rebuild. The NEXT_PUBLIC_
# spellings still work for local development.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser; it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Reminder email
RESEND_API_KEY=
REMINDER_FROM_ADDRESS=reminders@familygatekeeper.com

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

SITE_URL=http://localhost:3000
